<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="rough_terrain">
    <include>
      <uri>model://sun</uri>
    </include>
    <!-- Use a heightmap for the ground -->
    <model name="heightmap">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <heightmap>
              <uri>file:///home/thippe/my_robot/src/my_bot/worlds/heightmap.png</uri>
              <size>20 20 2</size> <!-- 20x20 meters, 2 meters max height -->
              <pos>0 0 0</pos>
            </heightmap>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <heightmap>
              <use_terrain_paging>false</use_terrain_paging>
              <texture>
                <diffuse>file://media/materials/textures/dirt_diffuse.png</diffuse>
                <normal>file://media/materials/textures/flat_normal.png</normal>
                <size>1</size>
              </texture>
              <uri>file:///home/thippe/my_robot/src/my_bot/worlds/heightmap.png</uri>
              <size>20 20 2</size>
              <pos>0 0 0</pos>
            </heightmap>
          </geometry>
        </visual>
      </link>
    </model>
  </world>
</sdf>
